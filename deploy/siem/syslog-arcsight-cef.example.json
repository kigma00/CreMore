{
  "schema_version": 1,
  "poll_seconds": 5.0,
  "batch_size": 100,
  "allow_plugins": [],
  "destinations": [
    {
      "id": "arcsight",
      "provider": "syslog_tls",
      "options": {
        "host": "arcsight-connector.internal.example",
        "port": 6514,
        "ca_file": "/etc/cremore-siem/arcsight-ca.pem",
        "cert_file": "/etc/cremore-siem/client.pem",
        "key_file": "/etc/cremore-siem/client.key",
        "message_format": "cef"
      }
    }
  ]
}
