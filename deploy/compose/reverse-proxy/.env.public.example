# External-exposure overlay settings. Copy to .env.public and fill in.
# Used together with the base .env:
#   docker compose --env-file .env --env-file .env.public \
#     -f docker-compose.yml -f deploy/compose/reverse-proxy/compose.public.yml up -d

# Public hostname Caddy serves and requests a certificate for (DNS must point here).
PUBLIC_HOST=cremore.example.com

# OIDC provider (same values the Helm chart's auth.oidc block uses).
OIDC_ISSUER_URL=https://idp.example.com
# For keys on another origin, set its exact URL. Discovery redirects are refused.
OIDC_JWKS_URL=
OIDC_AUDIENCE=credential-exposure-platform
OIDC_CLIENT_ID=credential-exposure-platform
OIDC_CLIENT_SECRET=
# 32 random bytes, base64url: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
OIDC_COOKIE_SECRET=

# AWS access is not configured here. Identity Center (`aws sso login`) is locked
# off by this overlay because a shared server would reach AWS as one person;
# register member accounts and deploy their read-only role instead.

# SIEM exporter, for a shared server that runs around the clock: add
#   -f deploy/compose/siem/compose.yml
# to the command above and fill these in. It restarts on its own and reads only
# the SIEM outbox with its own role (grants: docs/SIEM_INTEGRATION.md section 4).
SIEM_DATABASE_URL=
# Absolute host path of the destination JSON (examples in deploy/siem/).
SIEM_CONFIG_PATH=
# Only the token a destination names in token_env.
SPLUNK_HEC_TOKEN=
LOGSCALE_INGEST_TOKEN=
SIEM_HTTP_TOKEN=

# Group claim and the group → role mapping the API enforces. A user with no
# mapped group gets no access. Unset a role to grant it to nobody.
OIDC_GROUPS_CLAIM=groups
OIDC_VIEWER_GROUP=cep-viewers
OIDC_ANALYST_GROUP=cep-analysts
OIDC_REMEDIATOR_GROUP=cep-remediators
OIDC_ADMIN_GROUP=cep-admins
