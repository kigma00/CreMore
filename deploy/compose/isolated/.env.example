# Copy outside the checkout, restrict to the deployment administrator (0600),
# and fill every empty required value. Never commit the filled file.
# Reviewed images built from ONE source revision that includes isolated runtime.
CREMORE_PYTHON_REPOSITORY=ghcr.io/y4rvin/cremore-worker
CREMORE_PYTHON_SHA256=
CREMORE_WEB_REPOSITORY=ghcr.io/y4rvin/cremore-web
CREMORE_WEB_SHA256=
CREMORE_OIDC_REPOSITORY=ghcr.io/y4rvin/cremore-oauth2-proxy
CREMORE_OIDC_SHA256=
CREMORE_CADDY_REPOSITORY=caddy
CREMORE_CADDY_SHA256=

PUBLIC_HOST=cremore.example.org
PUBLIC_BIND_IP=127.0.0.1
TLS_CERT_DIRECTORY=/etc/cremore-isolated/gateway-tls
OIDC_ISSUER_URL=https://idp.example.org
OIDC_JWKS_URL=
OIDC_AUDIENCE=cremore
OIDC_CLIENT_ID=cremore
OIDC_CLIENT_SECRET=
OIDC_COOKIE_SECRET=
OIDC_SCOPES=openid profile email groups offline_access
OIDC_GROUPS_CLAIM=groups
OIDC_VIEWER_GROUP=cremore-viewer
OIDC_ANALYST_GROUP=cremore-analyst
OIDC_REMEDIATOR_GROUP=cremore-remediator
OIDC_ADMIN_GROUP=cremore-admin
# Optional: installed ticket-system plugins an admin may choose (comma-separated ids, e.g. jira).
# Empty offers none. See docs/TICKET_SYSTEMS.md.
TICKET_SYSTEM_PLUGINS=

# All six logins must be distinct and provisioned by deploy/postgres/README.md.
# URL-encode passwords. TLS validates the DB hostname against this CA bundle.
DATABASE_CA_PATH=/etc/cremore-isolated/public/database-ca.pem
API_DATABASE_URL=postgresql+psycopg://cremore_api:CHANGE_ME@db.example.org:5432/cremore?sslmode=verify-full&sslrootcert=/run/cremore/database-ca.pem
COLLECTOR_DATABASE_URL=postgresql+psycopg://cremore_collector:CHANGE_ME@db.example.org:5432/cremore?sslmode=verify-full&sslrootcert=/run/cremore/database-ca.pem
REMEDIATOR_DATABASE_URL=postgresql+psycopg://cremore_remediator:CHANGE_ME@db.example.org:5432/cremore?sslmode=verify-full&sslrootcert=/run/cremore/database-ca.pem
CONTROL_DATABASE_URL=postgresql+psycopg://cremore_control:CHANGE_ME@db.example.org:5432/cremore?sslmode=verify-full&sslrootcert=/run/cremore/database-ca.pem
SIEM_DATABASE_URL=postgresql+psycopg://cremore_siem:CHANGE_ME@db.example.org:5432/cremore?sslmode=verify-full&sslrootcert=/run/cremore/database-ca.pem
MIGRATION_DATABASE_URL=postgresql+psycopg://cremore_migration:CHANGE_ME@db.example.org:5432/cremore?sslmode=verify-full&sslrootcert=/run/cremore/database-ca.pem
# Collector task-runner processes, each scanning one task at a time with its own
# database connections and about 0.9 GiB of memory at peak (1-32; the collector's
# pids_limit of 1024 holds 32); 0 picks min(4, the CPUs the container may use).
WORKER_CONCURRENCY=0

# Independent stable random keys, at least 32 bytes each as hex.
# Preserve an existing installation's keys; changing them is an offline migration.
FINGERPRINT_KEY=
AUDIT_CHAIN_KEY=
CONTROL_SEALING_KEY=
SEALING_PUBLIC_KEYS_PATH=/etc/cremore-isolated/public/recipients.json
COLLECTOR_PRIVATE_KEYS_PATH=/etc/cremore-isolated/collector/private.json
REMEDIATOR_PRIVATE_KEYS_PATH=/etc/cremore-isolated/remediator/private.json
REMEDIATION_APPROVAL_PUBLIC_KEY_PATH=/etc/cremore-isolated/public/approval-public.pem

# Separate directories, never aliases/symlinks to a common credential directory.
COLLECTOR_CLOUD_IDENTITY_DIR=/etc/cremore-isolated/collector/cloud
REMEDIATOR_CLOUD_IDENTITY_DIR=/etc/cremore-isolated/remediator/cloud
# AWS projected identity: set each role ARN and its in-container token path.
# For Roles Anywhere leave those two empty and set the *_CONFIG path instead.
COLLECTOR_AWS_ROLE_ARN=
COLLECTOR_AWS_WEB_IDENTITY_TOKEN_FILE=
COLLECTOR_AWS_ROLES_ANYWHERE_CONFIG=
COLLECTOR_AWS_REGION=ap-northeast-2
REMEDIATOR_AWS_ROLE_ARN=
REMEDIATOR_AWS_WEB_IDENTITY_TOKEN_FILE=
REMEDIATOR_AWS_ROLES_ANYWHERE_CONFIG=
REMEDIATOR_AWS_REGION=ap-northeast-2
COLLECTOR_GCP_QUOTA_PROJECT=
REMEDIATOR_GCP_QUOTA_PROJECT=
COLLECTOR_AZURE_CLIENT_ID=
COLLECTOR_AZURE_TENANT_ID=
COLLECTOR_AZURE_AUTHORITY_HOST=https://login.microsoftonline.com/
REMEDIATOR_AZURE_CLIENT_ID=
REMEDIATOR_AZURE_TENANT_ID=
REMEDIATOR_AZURE_AUTHORITY_HOST=https://login.microsoftonline.com/

# Existing SIEM adapter JSON, with its token_env/client_secret_env set to
# SIEM_DESTINATION_TOKEN. Leave the token empty only for certificate-only sinks.
SIEM_CONFIG_PATH=/etc/cremore-isolated/siem/destination.json
SIEM_TLS_DIR=/etc/cremore-isolated/siem/tls
SIEM_DESTINATION_TOKEN=

# MUST be different preprovisioned, deny-default networks satisfying
# NETWORK_CONTRACT.md. Creating ordinary bridges is insufficient.
CREMORE_DNS_SERVER=192.0.2.53
CREMORE_EDGE_NETWORK=cremore-isolated-edge
CREMORE_API_NETWORK=cremore-isolated-api
CREMORE_COLLECTOR_NETWORK=cremore-isolated-collector
CREMORE_REMEDIATOR_NETWORK=cremore-isolated-remediator
CREMORE_CONTROL_NETWORK=cremore-isolated-control
CREMORE_SIEM_NETWORK=cremore-isolated-siem
CREMORE_OIDC_NETWORK=cremore-isolated-oidc
CREMORE_MIGRATION_NETWORK=cremore-isolated-migration
