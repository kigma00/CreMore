{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cremore:atlassian:jobs:1",
  "title": "Atlassian bounded job configuration",
  "$comment": "validate_config additionally enforces unique job names and runtime connection scope matching. No credentials are accepted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "jobs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "mode",
          "profile",
          "expected_scope"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "mode": {
            "enum": [
              "cloud-inventory",
              "cloud-discovery",
              "cloud-accounts",
              "bitbucket-core",
              "bitbucket-runners",
              "bitbucket-branches"
            ]
          },
          "profile": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "expected_scope": {
            "type": "string"
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_pages": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000,
                "default": 50
              },
              "max_records": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000,
                "default": 5000
              },
              "max_requests": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000,
                "default": 100
              },
              "retries": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5,
                "default": 2
              },
              "max_seconds": {
                "type": "number",
                "minimum": 1,
                "maximum": 600,
                "default": 120
              },
              "timeout": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 30,
                "default": 15
              },
              "max_retry_wait": {
                "type": "number",
                "minimum": 0,
                "maximum": 60,
                "default": 30
              }
            }
          },
          "max_targets": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 50
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 20
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "admin-api-keys",
                "org-api-tokens",
                "service-account-api-tokens",
                "service-account-oauth-clients",
                "org-oauth-clients"
              ]
            }
          },
          "include_account_reads": {
            "type": "boolean",
            "default": true
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "enum": [
                    "cloud-inventory",
                    "cloud-discovery",
                    "cloud-accounts"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "expected_scope": {
                  "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
                }
              }
            },
            "else": {
              "properties": {
                "expected_scope": {
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,99}$"
                },
                "page_size": {
                  "maximum": 100
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "mode": {
                  "enum": [
                    "cloud-inventory",
                    "cloud-accounts"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "page_size": {
                  "const": 20
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "sources"
              ]
            },
            "then": {
              "properties": {
                "mode": {
                  "const": "cloud-inventory"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "include_account_reads"
              ]
            },
            "then": {
              "properties": {
                "mode": {
                  "const": "cloud-discovery"
                }
              }
            }
          }
        ]
      }
    },
    "max_requests": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 300
    },
    "max_seconds": {
      "type": "number",
      "minimum": 1,
      "maximum": 600,
      "default": 600
    }
  }
}
