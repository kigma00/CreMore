        },
        "collection_mode": {
          "enum": [
            "core",
            "runners",
            "branch_restrictions"
          ]
        },
        "collections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/collection"
          }
        },
        "targets": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "targets_omitted_by_limit": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "key_details_omitted_by_limit": {
          "type": "integer",
          "minimum": 0
        },
        "runner_details_omitted_by_limit": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_identifiers": {
          "type": "integer",
          "minimum": 0
        },
        "not_requested_no_observed_targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not_requested_operations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not_requested_by_mode": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "public_listing_contract_unverified": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "provider",
        "inventory_complete",
        "started_at",
        "finished_at",
        "run_status",
        "limits",
        "schema_version",
        "environment",
        "report_type",
        "workspace",
        "collection_mode",
        "collections",
        "targets",
        "targets_omitted_by_limit",
        "key_details_omitted_by_limit",
        "runner_details_omitted_by_limit",
        "invalid_identifiers",
        "not_requested_no_observed_targets",
        "not_requested_operations",
        "not_requested_by_mode",
        "public_listing_contract_unverified"
      ]
    },
    "event": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "object"
        },
        "change_type": {
          "enum": [
            "first_observed",
            "metadata_changed",
            "not_observed",
            "observation_unknown",
            "metadata_unknown"
          ]
        },
        "before_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "after_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unknown_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        },
        "baseline_complete": {
          "type": "boolean"
        }
      },
      "required": [
        "identity",
        "change_type",
        "before_refs",
        "after_refs"
      ]
    },
    "comparison_source": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string"
        },
        "context": {
          "type": "object"
        },
        "before": {
          "type": "object"
        },
        "after": {
          "type": "object"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "unchanged_observations": {
          "type": "integer",
          "minimum": 0
        },
        "comparison_limited": {
          "type": "boolean"
        }
      },
      "required": [
        "operation",
        "context",
        "before",
        "after",
        "events",
        "unchanged_observations",
        "comparison_limited"
      ]
    },
    "comparison": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "report_type": {
          "const": "metadata_snapshot_comparison"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "before_window": {
          "$ref": "#/$defs/window"
        },
        "after_window": {
          "$ref": "#/$defs/window"
        },
        "comparison_status": {
          "enum": [
            "complete",
            "limited"
          ]
        },
        "input_limits": {
          "type": "object",
          "properties": {
            "before": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "after": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "before",
            "after"
          ]
        },
        "inventory_complete": {
          "const": false
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/comparison_source"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "input_sha256": {
          "type": "object",
          "properties": {
            "before": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "after": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "before",
            "after"
          ]
        }
      },
      "required": [
        "schema_version",
        "report_type",
        "scope",
        "before_window",
        "after_window",
        "comparison_status",
        "input_limits",
        "inventory_complete",
        "counts",
        "sources",
        "limitations"
      ]
    },
    "job_entry": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "profile": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "expected_scope": {
          "type": "string"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "requests": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "enum": [
            "running",
            "collected",
            "configuration_error",
            "execution_error",
            "skipped_budget",
            "interrupted",
            "skipped_after_interrupt"
          ]
        },
        "run_status": {
          "enum": [
            "complete",
            "partial",
            "failed",
            "unverified"
          ]
        },
        "output_file": {
          "type": "string",
          "pattern": "^(inventory|diagnostic)-[0-9a-f]{32}\\.json$"
        },
        "output_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "effective_limits": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "mode",
        "profile",
        "expected_scope",
        "started_at",
        "requests",
        "state"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "collected"
              }
            }
          },
