{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cremore:atlassian:outputs:2026-09-21",
  "title": "CreMore Atlassian output contracts (provider-specific; not the team schema)",
  "$comment": "Unknown provider metadata fields remain allowed. Shape validation cannot prove authorization, full coverage, correct counts, or authenticity. Native inventory schema 3 has no required report_type.",
  "oneOf": [
    {
      "$ref": "#/$defs/inventory"
    },
    {
      "$ref": "#/$defs/cloud_discovery"
    },
    {
      "$ref": "#/$defs/bitbucket"
    },
    {
      "$ref": "#/$defs/comparison"
    },
    {
      "$ref": "#/$defs/manifest"
    },
    {
      "$ref": "#/$defs/diagnostic"
    },
    {
      "$ref": "#/$defs/recollection"
    },
    {
      "$ref": "#/$defs/part"
    },
    {
      "$ref": "#/$defs/plan"
    }
  ],
  "$defs": {
    "page": {
      "type": "object",
      "properties": {
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "http_status": {
          "const": 200
        },
        "metadata": {},
        "field_types": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "redactions": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "received_records": {
          "type": "integer",
          "minimum": 0
        },
        "saved_records": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "observed_at",
        "http_status",
        "metadata",
        "field_types",
        "redactions",
        "received_records",
        "saved_records"
      ]
    },
    "collection": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string"
        },
        "method": {
          "enum": [
            "GET",
            "POST"
          ]
        },
        "coverage": {
          "enum": [
            "complete",
            "partial",
            "failed",
            "unverified",
            "not_requested"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "requests": {
          "type": "integer",
          "minimum": 0
        },
        "received_records": {
          "type": "integer",
          "minimum": 0
        },
        "saved_records": {
          "type": "integer",
          "minimum": 0
        },
        "last_http_status": {
          "type": [
            "integer",
            "null"
          ]
        },
        "pages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/page"
          }
        },
        "redactions": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "record_quality": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "target_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "requested_account_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recollection_task_index": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "operation",
        "method",
        "coverage",
        "reason",
        "requests",
        "received_records",
        "saved_records",
        "last_http_status",
        "pages",
        "redactions"
      ]
    },
    "legacy_collection": {
      "type": "object",
      "properties": {
        "coverage": {
          "enum": [
            "complete",
            "partial",
            "failed",
            "unverified",
            "not_requested"
          ]
        },
        "pages": {
          "type": "integer",
          "minimum": 0
        },
        "requests": {
          "type": "integer",
          "minimum": 0
        },
        "received_records": {
          "type": "integer",
          "minimum": 0
        },
        "accepted_records": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_records": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_observations": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_http_status": {
          "type": [
            "integer",
            "null"
          ]
        },
        "redactions": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": [
        "coverage"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "coverage": {
                "not": {
                  "const": "not_requested"
                }
              }
            }
          },
          "then": {
            "required": [
              "pages",
              "requests",
              "received_records",
              "accepted_records",
              "invalid_records",
              "duplicate_observations",
              "reason",
              "last_http_status"
            ]
          }
        }
      ]
    },
    "field": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "present",
            "missing",
            "null",
            "invalid_type"
          ]
        },
        "value": {},
        "normalized_utc": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "state"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "present"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ]
          },
          "else": {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        }
      ]
    },
    "observation": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "record_contract": {
          "type": "string"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        },
        "parent_states": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "present",
              "missing",
              "null",
              "invalid_type"
            ]
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "derived": {
          "type": "object"
        }
      },
      "required": [
        "source",
        "record_contract",
        "observed_at",
        "fields",
        "parent_states",
        "warnings",
        "derived"
      ]
    },
    "identity": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "provider_id": {
          "type": "string"
        },
        "principal_kind": {
          "enum": [
            "unknown",
            "service_account"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflict_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        }
      },
      "required": [
        "kind",
        "provider_id",
        "principal_kind",
        "sources",
        "conflict_fields",
        "observations"
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "provider": {
          "const": "atlassian"
        },
        "environment": {
          "enum": [
            "cloud",
            "bitbucket_cloud"
          ]
        },
        "report_type": {
          "enum": [
            "inventory",
            "metadata_discovery",
            "managed_account_metadata_discovery",
            "bitbucket_metadata_discovery"
          ]
        },
        "schema_version": {
          "enum": [
            1,
            3
          ]
        },
        "scope_id": {
          "type": "string"
        },
        "collection_mode": {
          "enum": [
            null,
            "core",
            "runners",
            "branch_restrictions"
          ]
        },
        "connection_profile": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        }
      },
      "required": [
        "provider",
        "environment",
        "report_type",
        "schema_version",
        "scope_id",
        "collection_mode",
        "connection_profile"
      ]
    },
    "window": {
      "type": "object",
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "started_at",
        "finished_at"
      ]
    },
    "inventory": {
      "type": "object",
      "properties": {
        "provider": {
          "const": "atlassian"
        },
        "inventory_complete": {
          "const": false
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "run_status": {
          "enum": [
            "complete",
            "partial",
            "failed",
            "unverified"
          ]
        },
        "limits": {
          "type": "object"
        },
        "connection_profile": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "schema_version": {
          "const": 3
        },
        "environment": {
          "const": "cloud"
        },
        "queried_org_id": {
          "type": "string"
        },
        "report_type": {
          "const": "inventory"
        },
        "requested_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "collections": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/legacy_collection"
          }
        },
        "inventory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identity"
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "warning_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "identity_link_candidates": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "provider",
        "inventory_complete",
        "started_at",
        "finished_at",
        "run_status",
        "limits",
        "schema_version",
        "environment",
        "queried_org_id",
        "requested_sources",
        "collections",
        "inventory",
        "counts",
        "warning_counts",
        "identity_link_candidates"
      ]
    },
    "cloud_discovery": {
      "type": "object",
      "properties": {
        "provider": {
          "const": "atlassian"
        },
        "inventory_complete": {
          "const": false
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "run_status": {
          "enum": [
            "complete",
            "partial",
            "failed",
            "unverified"
          ]
        },
        "limits": {
          "type": "object"
        },
        "connection_profile": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "schema_version": {
          "const": 1
        },
        "environment": {
          "const": "cloud"
        },
        "report_type": {
          "enum": [
            "metadata_discovery",
            "managed_account_metadata_discovery"
          ]
        },
        "queried_org_id": {
          "type": "string"
        },
        "collections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/collection"
          }
        },
        "target_discovery": {
          "type": "object",
          "properties": {
            "user_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "service_account_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "oauth_client_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "invalid_identifiers": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "user_ids",
            "service_account_ids",
            "oauth_client_ids",
            "invalid_identifiers"
          ]
        },
        "targets_omitted_by_limit": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "count_ids_exceeding_contract_limit": {
          "type": "integer",
          "minimum": 0
        },
        "not_requested_no_observed_targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "count_comparisons": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "not_requested_by_configuration": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "provider",
        "inventory_complete",
        "started_at",
        "finished_at",
        "run_status",
        "limits",
        "schema_version",
        "environment",
        "report_type",
        "queried_org_id",
        "collections",
        "target_discovery",
        "targets_omitted_by_limit",
        "count_ids_exceeding_contract_limit",
        "not_requested_no_observed_targets",
        "count_comparisons"
      ]
    },
    "bitbucket": {
      "type": "object",
      "properties": {
        "provider": {
          "const": "atlassian"
        },
        "inventory_complete": {
          "const": false
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "run_status": {
          "enum": [
            "complete",
            "partial",
            "failed",
            "unverified"
          ]
        },
        "limits": {
          "type": "object"
        },
        "connection_profile": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
